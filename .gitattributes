# Normalise to LF in the repository; Git checks out native line endings.
# Without this, a Windows working copy commits CRLF and every file shows as
# changed for anyone on macOS or Linux.
* text=auto eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
